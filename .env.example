# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must never be committed.
# Both values come from your own IBM Quantum account at quantum.cloud.ibm.com.

# Your IBM Quantum API key. Read by the scripts with os.getenv("IBM_API_KEY").
IBM_API_KEY=

# Your IBM Quantum instance CRN. Read by the scripts with os.getenv("IBM_INSTANCE").
IBM_INSTANCE=
